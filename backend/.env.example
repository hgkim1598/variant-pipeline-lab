# Copy to backend/.env (git-ignored) and fill in for this machine.
#
# Reference-bundle values are supplied by the operator, never by the browser.
# Leave a value blank rather than guessing: main.sh is fail-closed and a wrong
# reference is far worse than a refused run.

# check_only -> main.sh --check-only (preflight only; no analysis tool runs)
# full       -> the whole pipeline. Requires bwa/samtools/gatk/bcftools/tabix/
#               bgzip/mosdepth/fastqc on PATH.
WES_RUN_MODE=check_only

# bash executable. Git Bash on Windows, system bash on Linux.
WES_BASH=bash

# Reference bundle. Every path is read by main.sh, not by the backend.
WES_ASSEMBLY=GRCh38
# Read the FIRST COLUMN of the reference .fai and declare it. Do not guess:
#   contigs named chr1  -> chr
#   contigs named 1     -> plain
WES_CONTIG_STYLE=
WES_BUNDLE_ID=grch38_wes_germline
WES_REFERENCE_FASTA=
# Comma-separated list of BQSR known-sites VCFs.
WES_KNOWN_SITES=
WES_DBSNP_VCF=

# Optional InterVar / ACMG classification (11_intervar).
#
# Set ALL THREE or NONE. All three set -> the UI's "ACMG 자동 분류" option is
# honoured. None set -> the option is reported back as unsupported and the step
# is not planned. A partial setting is refused at startup, because it means the
# operator meant to enable this and got it wrong.
#
# main.sh never installs InterVar or the ANNOVAR humandb; both directories must
# already exist. WES_INTERVAR_BUILD must match the assembly (GRCh38 -> hg38);
# main.sh validates that pair itself and fails the optional step if it is wrong.
WES_INTERVAR_DIR=
WES_INTERVAR_BUILD=
WES_INTERVAR_HUMANDB=

# Compute
WES_THREADS=4
WES_JAVA_MEM_GB=8
