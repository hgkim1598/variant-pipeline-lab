# Mock switch for `npm run dev`.
#   true  -> src/mocks/handlers.ts (MSW) answers /api/*, no backend needed
#   false -> /api/* is proxied to FastAPI at http://127.0.0.1:8000 (vite.config.ts)
#
# Override locally without touching this file by creating .env.local
# (git-ignored) containing VITE_USE_MOCK=true.
VITE_USE_MOCK=false
